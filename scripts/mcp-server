#!/usr/bin/env bash
# Launcher for the MCP server, speaking stdio.
#
# Sets PYTHONPATH to src/ rather than relying on the editable install, which
# uv breaks on macOS by writing .pth files with the UF_HIDDEN flag that
# CPython >= 3.12 silently skips. See docs/troubleshooting.md.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
exec env PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
  uv run --no-sync python -m lt25_mcp.server
