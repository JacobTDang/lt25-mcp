#!/usr/bin/env bash
# Run python in the project venv.
#
# Sets PYTHONPATH to src/ rather than relying on the editable install, which
# uv breaks on macOS: it writes .pth files with the UF_HIDDEN flag, and
# CPython >= 3.12 silently skips hidden .pth files. See docs/troubleshooting.md.
#
# Usage: ./scripts/py [args...]     -- same as `uv run python [args...]`
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
uv sync --quiet
exec env PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" uv run --no-sync python "$@"
